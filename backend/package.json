{
  "name": "cron-manager-backend",
  "version": "1.0.0",
  "description": "Backend service for Dynamic Cron / Scheduled Job Management System",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
